{
  "name": "ombro-app",
  "private": true,
  "version": "0.5.0-alpha.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "build:backend": "PY=python3; [ -x ../.venv/bin/python ] && PY=../.venv/bin/python; \"$PY\" -I scripts/build_backend.py --sign \"${APPLE_SIGNING_IDENTITY:--}\"",
    "build:app": "npm run build:backend && tauri build --config src-tauri/tauri.release.conf.json --bundles app,dmg"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.1",
    "lucide-react": "^1.73.0",
    "open-bot-avatar": "0.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "~2.11.5",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14",
    "@types/node": "^24",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^31.0.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.1.0"
  }
}
