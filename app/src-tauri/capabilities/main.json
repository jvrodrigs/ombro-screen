{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "A janela principal: s\u00f3 os comandos do Ombro, eventos e arrastar a janela. Sem shell, sem sistema de arquivos, sem plugins no JavaScript.",
  "windows": [
    "main"
  ],
  "local": true,
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-get-snapshot",
    "allow-refresh",
    "allow-app-info",
    "allow-daemon-start",
    "allow-daemon-restart",
    "allow-display-status",
    "allow-display-preview",
    "allow-config-get",
    "allow-config-schema",
    "allow-config-update",
    "allow-display-set-brightness",
    "allow-display-set-layout",
    "allow-integrations-list",
    "allow-integration-run",
    "allow-service-run",
    "allow-doctor-run",
    "allow-doctor-report",
    "allow-prefs-get",
    "allow-prefs-set",
    "allow-autostart-set",
    "allow-open-link"
  ]
}
